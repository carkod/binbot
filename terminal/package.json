{
  "name": "terminal-binbot",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && cp ./charting_library/manifest.webmanifest ./dist/charting_library/manifest.webmanifest && cp ./charting_library/favicon.ico ./dist/charting_library/favicon.ico && cp ./charting_library/binbot-icon.svg ./dist/charting_library/binbot-icon.svg && cp ./charting_library/binbot-icon-512.png ./dist/charting_library/binbot-icon-512.png && cp ./charting_library/apple-touch-icon.png ./dist/charting_library/apple-touch-icon.png",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write . && eslint --fix .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "install:clean": "rm -rf dist node_modules package-lock.json && npm i"
  },
  "dependencies": {
    "@mantine/core": "^9.8.1",
    "@mantine/dates": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@reduxjs/toolkit": "^2.0.1",
    "binbot-charts": "^0.17.3",
    "dayjs": "^1.11.23",
    "moment": "^2.31.0",
    "motion": "^14.14.0",
    "plotly": "^1.0.6",
    "plotly.js": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.53.0",
    "react-plotly.js": "^2.6.0",
    "react-redux": "^9.1.0",
    "react-router": "^8.3.0",
    "react-toastify": "^10.0.5",
    "use-immer": "^0.11.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/eslint__eslintrc": "^2.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "fake-indexeddb": "^6.2.8",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.2.1",
    "typescript": "^5.3.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "use-immer": "$use-immer"
  }
}
